# Scenario worker Caddyfile. The hello Caddyfile only reaches its worker on
# arbitrary paths because php_server's try_files falls back to index.php — the
# worker's own filename; for the differently-named scenario.php an explicit
# `rewrite` sends EVERY method/path to the resident worker instead. The worker is
# registered in the global block (per-handler `worker { match * num N }` inside
# php_server parses on v1.12.4 but the runtime ignores `num` and auto-sizes to 48).
# 32 workers + 1 spare = 33; num_threads must be STRICTLY GREATER than the worker
# count. No `encode` directive, so responses are uncompressed (parity with rapira).
# Run from THIS directory:  ./frankenphp run --config Caddyfile.scenario
{
	auto_https off
	admin off

	frankenphp {
		num_threads 33

		worker {
			file ./scenario.php
			num 32
		}
	}
}

:8080 {
	root * .
	rewrite * /scenario.php
	php_server
}
